{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": { "@/*": ["./*"] }
  },
  "include": ["src/**/*.ts", "bench/**/*.ts", "test/**/*.ts"]
}
