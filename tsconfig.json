{
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false
  },
  "include": ["scripts/**/*.ts", "ops/**/*.ts", "telemetry/**/*.ts", "bench/**/*.ts", "probes/**/*.ts", "board/trace/**/*.ts", "board/test/**/*.ts", "app/src/**/*.test.ts"]
}
