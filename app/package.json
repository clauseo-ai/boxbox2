{
  "name": "boxbox-app",
  "description": "the boxbox web app: a home-screen client for cmx2 coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clauseo-ai/boxbox2.git",
    "directory": "app"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "stories": "ladle serve --config .ladle",
    "stories:build": "ladle build --config .ladle",
    "stories:check": "tsc --noEmit -p .ladle",
    "shots": "bun .ladle/shots.ts",
    "shots:home": "bun .ladle/home-shots.ts",
    "shots:shell": "bun .ladle/shell-shots.ts",
    "icons": "bun ../scripts/icons.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "marked": "18.0.14",
    "openapi-fetch": "0.17.0",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "@ladle/react": "5.1.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "fake-indexeddb": "6.2.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.1",
    "vite-plugin-solid": "2.11.14"
  }
}
