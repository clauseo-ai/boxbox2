{
  "golden": "prompt-accepted",
  "proves": "a prompt is 202 with the daemon's {messageID, queued} and repeat false",
  "request": {
    "method": "POST",
    "path": "/api/hosts/bench/sessions/<ses 1>/prompt",
    "accept-encoding": "gzip",
    "body": {
      "device": "golden-phone",
      "deviceClass": "iphone",
      "clientID": "golden-prompt-1",
      "text": "[bench:words 4 1] say four words"
    }
  },
  "status": 202,
  "headers": {
    "content-type": "application/json"
  },
  "body": {
    "repeat": false,
    "answer": {
      "messageID": "<msg 1>",
      "queued": false
    }
  }
}
