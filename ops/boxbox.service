# systemd user unit for boxbox (docs/deploy.md). install.sh puts it at
# ~/.config/systemd/user/boxbox.service; then:
#   systemctl --user daemon-reload && systemctl --user enable --now boxbox
#   loginctl enable-linger "$USER"   # keep it running while you are logged out
# the port and everything else live in boxbox.toml, so this file is the same
# on every machine.

[Unit]
Description=boxbox, the server between your cmx2 daemons and your devices
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# installed by atomic rename (install.sh): a running binary is never copied over
ExecStart=%h/.local/bin/boxbox serve --config %h/.config/boxbox/boxbox.toml
Environment=RUST_LOG=boxbox=info
Restart=on-failure
RestartSec=2
# sigterm drains: stop accepting, end every stream, flush telemetry, exit
# inside 5 s. systemd waits a little longer before it kills.
KillSignal=SIGTERM
TimeoutStopSec=8
# the backstop, never the plan: steady rss is budgeted at 64 mb for 3 hosts
# and 300 sessions (docs/architecture.md, memory)
MemoryMax=256M
MemoryHigh=192M
# the config, the cookie secret and the db are private to their owner
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
